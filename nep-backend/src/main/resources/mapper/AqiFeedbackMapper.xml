<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.neusoft.nep.mapper.AqiFeedbackMapper">
    <select id="selectTaskPage" resultType="com.neusoft.nep.entity.AqiFeedback">
        SELECT * FROM aqi_feedback
        WHERE gm_id = #{gmId}
        ORDER BY af_date DESC, af_time DESC
    </select>

    <select id="selectDetail" resultType="com.neusoft.nep.entity.AqiFeedback">
        SELECT * FROM aqi_feedback
        WHERE af_id = #{afId}
    </select>
</mapper>
